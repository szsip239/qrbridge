#!/usr/bin/env python3
"""Checks shared by agent hooks, git hooks and CI.

  agent-check file PATH...       lint PATHs, reporting only lines changed since HEAD
  agent-check diff [--base REV] [--lint-only | --all-checks]
                                 lint files changed since REV (default HEAD), then run CHECKS for them;
                                 --all-checks runs CHECKS as in full mode, for CI
  agent-check full               lint every tracked file, then run CHECKS

CHECKS also runs scripts/tla-check, when present, on the same files. Exits 3 when the only
failures are scripts/tla-check exiting 3, which only the user can resolve.

Copied from szsip239/smart-coding templates/agent-check; edit only the config block.
"""
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# --- config ---
# (suffixes, command): the command receives file paths and prints one `path:line[:col]: message` line per finding.
LINTERS = [
    (('.py',), ['uvx', 'ruff@0.17.3', 'check', '--output-format', 'concise', '--no-fix', '--force-exclude']),
]
# Commands that must exit 0, run after linting in diff and full modes. May instead be a function
# CHECKS(files) returning commands for the changed files; files is None in full mode.
def CHECKS(files):
    commands = [['python3', 'bridge.py', '--help']]
    if files is None or any(path.startswith('dsh/') for path in files):
        commands.append(['sh', '-c', 'cd dsh && node --test tests/*.test.mjs'])
    return commands
# --- end config ---

FINDING = re.compile(r'^(.+?):(\d+)(?::\d+)?:\s')
NOQA = re.compile(r'#\s*noqa:\s*((?:[A-Z]+\d+[,\s]*)+)(.*)')
CATCH_RULES = {'BLE001', 'S110', 'S112', 'E722', 'TRY301'}
HUNK = re.compile(r'^@@ -\S+ \+(\d+)(?:,(\d+))? @@')
NEEDS_USER = 3


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, text=True, check=True).stdout


def changed_lines(base, files):
    """path -> set of changed line numbers, or None when the whole file is new."""
    changed = {f: set() for f in files}
    current = None
    for line in git('diff', '-U0', '--no-color', base, '--', *files).splitlines():
        if line.startswith('+++ '):
            current = line[6:] if line.startswith('+++ b/') else None
        elif current and (m := HUNK.match(line)):
            start, count = int(m.group(1)), int(m.group(2) or 1)
            changed.setdefault(current, set()).update(range(start, start + count))
    for f in git('ls-files', '--others', '--exclude-standard', '--', *files).splitlines():
        changed[f] = None
    return changed


def bare_noqa(files, changed):
    """A catch rule silenced without a reason on the same line or in a comment right below it."""
    problems = []
    for f in files:
        if not f.endswith('.py') or not Path(f).is_file():
            continue
        lines = Path(f).read_text(encoding='utf-8').splitlines()
        wanted = changed.get(f, set()) if changed is not None else None
        for n, line in enumerate(lines, 1):
            m = NOQA.search(line)
            if (m and CATCH_RULES & set(re.findall(r'[A-Z]+\d+', m.group(1))) and not m.group(2).strip(' #-')
                    and not (n < len(lines) and lines[n].lstrip().startswith('#'))
                    and (wanted is None or n in wanted)):
                problems.append(f'{f}:{n}: NOQA001 捕获类规则被 noqa 关掉却没写原因。在同一行写 `# noqa: 规则  # 哪个调用方需要这个捕获`')
    return problems


def lint(files, base):
    problems = []
    changed = changed_lines(base, files) if base else None
    for suffixes, command in LINTERS:
        targets = [f for f in files if f.endswith(suffixes) and Path(f).is_file()]
        if not targets:
            continue
        r = subprocess.run([*command, *targets], capture_output=True, text=True)
        output = (r.stdout + r.stderr).strip()
        findings = [(line, m) for line in output.splitlines() if (m := FINDING.match(line))]
        if r.returncode and not findings:
            problems.append(f'{command[0]} 运行失败：\n{output}')
            continue
        for line, m in findings:
            path = Path(m.group(1)).resolve().relative_to(Path.cwd()).as_posix()
            lines = changed.get(path, set()) if changed is not None else None
            if lines is None or int(m.group(2)) in lines:
                problems.append(line)
    return problems + bare_noqa(files, changed)


def run(command):
    r = subprocess.run(command, capture_output=True, text=True)
    tail = '\n'.join((r.stdout + r.stderr).strip().splitlines()[-60:])
    return r.returncode, f'{" ".join(command)} 失败：\n{tail}'


def run_checks(files):
    """(failures, scripts/tla-check failures that wait on the user). Runs up to one command per CPU at once."""
    commands = list(CHECKS(files) if callable(CHECKS) else CHECKS)
    if Path('scripts/tla-check').is_file():
        commands.append(['scripts/tla-check', *(files or [])])
    problems, waiting = [], []
    with ThreadPoolExecutor(os.cpu_count()) as pool:
        for command, (code, report) in zip(commands, pool.map(run, commands)):
            if code:
                (waiting if code == NEEDS_USER and command[0] == 'scripts/tla-check' else problems).append(report)
    return problems, waiting


def main():
    root = Path(git('rev-parse', '--show-toplevel').strip())
    mode, args = sys.argv[1], sys.argv[2:]
    files = [Path(a).resolve().relative_to(root).as_posix() for a in args] if mode == 'file' else []
    os.chdir(root)
    waiting = []
    if mode == 'file':
        problems = lint(files, 'HEAD')
    elif mode == 'diff':
        base = args[args.index('--base') + 1] if '--base' in args else 'HEAD'
        files = git('diff', '--name-only', '--diff-filter=d', base).splitlines()
        files += git('ls-files', '--others', '--exclude-standard').splitlines()
        problems = lint(files, base)
        if files and '--lint-only' not in args:
            checked, waiting = run_checks(None if '--all-checks' in args else files)
            problems += checked
    elif mode == 'full':
        checked, waiting = run_checks(None)
        problems = lint(git('ls-files').splitlines(), None) + checked
    else:
        sys.exit(f'unknown mode: {mode}')
    print('\n'.join(problems + waiting))
    sys.exit(1 if problems else NEEDS_USER if waiting else 0)


if __name__ == '__main__':
    main()
